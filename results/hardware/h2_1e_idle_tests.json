  "plan": {
    "T0": {
      "question": "Do emulator options sent through aqora take effect?",
      "decision": "X-basis sleep(1.0) with dephasing off consistent with 0, far below the ~9% seen with it on -> options reach the emulator.",
      "runs": [
        {
          "name": "T0_X_sleep1_off",
          "kind": "probe",
          "basis": "X",
          "sleep": 1.0,
          "options": "off",
          "shots": 1000
        }
      ]
    },
    "T1": {
      "question": "Is the hand-inserted sleep the instruction Quantinuum's own converter emits?",
      "decision": "Same __quantum__qis__sleep__body(qubit, double) call from pytket-qir -> the hand edit is the official instruction. Every program here uses pytket-qir. The unit (seconds) is not documented and stays inferred.",
      "runs": []
    },
    "T2": {
      "question": "Does sleep cause dephasing only, or also bit flips?",
      "decision": "Z-basis errors consistent with 0 at every sleep -> dephasing only.",
      "runs": [
        {
          "name": "T2_Z_sleep0",
          "kind": "probe",
          "basis": "Z",
          "sleep": 0.0,
          "options": "on",
          "shots": 1000
        },
        {
          "name": "T2_Z_sleep0p1",
          "kind": "probe",
          "basis": "Z",
          "sleep": 0.1,
          "options": "on",
          "shots": 1000
        },
        {
          "name": "T2_Z_sleep0p5",
          "kind": "probe",
          "basis": "Z",
          "sleep": 0.5,
          "options": "on",
          "shots": 1000
        },
        {
          "name": "T2_Z_sleep0p75",
          "kind": "probe",
          "basis": "Z",
          "sleep": 0.75,
          "options": "on",
          "shots": 1000
        },
        {
          "name": "T2_Z_sleep1",
          "kind": "probe",
          "basis": "Z",
          "sleep": 1.0,
          "options": "on",
          "shots": 1000
        }
      ]
    },
    "T3": {
      "question": "What are the linear (gamma) and quadratic (f*k) idle terms?",
      "decision": "Fit P = floor (+) [a + b - 2ab], a = gamma t, b = sin^2(pi fk t), with uncertainties; compare with the configured gamma = 0.0028/s, fk = 0.086. Shots give >= ~20 expected errors per point under the configured model.",
      "runs": [
        {
          "name": "T3_X_sleep0",
          "kind": "probe",
          "basis": "X",
          "sleep": 0.0,
          "options": "on",
          "shots": 20000
        },
        {
